# NIZAMY Blog — API Environment Variables
# Copy this file to api/.env on your server and fill in real values.
# NEVER commit api/.env to version control.

DB_HOST=localhost
DB_NAME=nizamy_blog
DB_USER=nizamy_admin
DB_PASS=CHANGE_ME_TO_REAL_PASSWORD

API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
SITE_URL=https://nizamy.com

# Auto Blog — Gemini AI + Unsplash
GEMINI_API_KEY=your_gemini_api_key
UNSPLASH_KEY=your_unsplash_access_key
CRON_SECRET=your_random_secret_for_cron
